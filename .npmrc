# Security settings
audit=true
audit-level=high
fund=false
package-lock=true
save-exact=true

# Prevent accidental publishing
access=restricted

# Use strict SSL
strict-ssl=true

# Use the public npm registry
registry=https://registry.npmjs.org/

# Disable scripts during install
ignore-scripts=true

# Set maximum number of concurrent connections
maxsockets=50

# Set timeout for network requests
fetch-timeout=300000
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Set cache settings
cache-min=3600
cache-max=infinity
cache=.npm-cache

# Set log level
loglevel=warn 