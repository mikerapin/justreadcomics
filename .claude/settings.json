{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(npm run lint)", "Bash(npm run test *)", "Bash(git check-ignore *)"],
    "deny": [
      "Bash(curl *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(packages/**/config/.env*)",
      "Read(packages/**/config/*.env*)"
    ]
  },
  "enabledMcpjsonServers": []
}
